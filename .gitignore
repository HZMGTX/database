# ── The local database and its sidecars ──────────────────────────────────────
# Data lives in ./data/ so it sits beside the code and is trivial to copy, but
# it is NEVER committed: it is personal data.
#
# Every path here is anchored with a leading slash. Without one, `data/`
# matches a directory of that name at ANY depth.
/data/
*.db
*.db-wal
*.db-shm

# ── Attachments, backups, logs, scratch ──────────────────────────────────────
/files/
/backups/
/inbox/
/logs/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ── The web app ──────────────────────────────────────────────────────────────
node_modules/
.vercel/
*.tsbuildinfo

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
