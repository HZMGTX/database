# ── The database and its sidecars ────────────────────────────────────────────
# Vault's data lives in ./data/ so it sits beside the code and is trivial to
# copy, but it is NEVER committed: it is personal data.
data/
*.db
*.db-wal
*.db-shm

# ── Attachments, backups, logs, scratch ──────────────────────────────────────
files/
backups/
inbox/
logs/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# ── OS noise ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
